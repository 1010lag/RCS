{
  "name": "rcs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "demo": "tsx server/seed.ts",
    "admin": "tsx server/bootstrap.ts",
    "push:setup": "tsx scripts/setup-push.ts",
    "android:sync": "npm run build && cap sync android",
    "android:build": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "android:install": "powershell -ExecutionPolicy Bypass -File scripts/install-android.ps1",
    "start:lan": "tsx scripts/lan.ts",
    "dev:lan": "concurrently -k -n api,web \"tsx watch scripts/lan.ts\" \"vite --host 127.0.0.1\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/push-notifications": "^8.1.3",
    "@electric-sql/pglite": "^0.3.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.8",
    "@firebase/app": "^0.16.4",
    "@firebase/messaging": "^0.13.3",
    "@node-rs/argon2": "^2.0.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "glob": "^14.0.3"
  }
}
