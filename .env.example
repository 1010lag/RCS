# Optional: without DATABASE_URL, local PostgreSQL (PGlite) persists in .data/.
DATABASE_URL=
DATA_DIR=.data/database
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
# Set NODE_ENV=production behind an HTTPS reverse proxy.
NODE_ENV=development
# Only addresses of your own reverse proxies; empty means no forwarded-IP trust.
# Example for nginx on this host: 127.0.0.1,::1
TRUSTED_PROXIES=
# Optional FCM service-account path (outside the repository).
GOOGLE_APPLICATION_CREDENTIALS=
# Alternative for hosts supporting secret environment variables instead of secret files.
# Full service-account JSON; never expose to frontend or commit to Git.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Android push only needs server credentials and this project ID (also inferred from the credentials file).
FIREBASE_PROJECT_ID=
# For Google-hosted workloads with an attached service account, use ADC instead:
FIREBASE_USE_ADC=0
# Optional browser/PWA push configuration. Not required for the native Android APK.
FIREBASE_WEB_CONFIG=
FIREBASE_VAPID_KEY=
# Optional public HTTPS APK URL when the host has no persistent local APK file.
APK_DOWNLOAD_URL=
# Hosted start defaults to an hour between idle cleanup runs; actual deadlines wake earlier.
# Local development keeps the previous 15-second interval unless explicitly overridden.
WORKER_IDLE_MS=
